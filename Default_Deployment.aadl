PACKAGE deploymentview::DV::Node_Linux
PUBLIC

WITH Taste;
WITH Deployment;
WITH TASTE_DV_Properties;
WITH deploymentview::DV;
WITH Memory_Properties;
WITH ARINC653;

PROCESS demo
END demo;

PROCESS IMPLEMENTATION demo.others
END demo.others;

END deploymentview::DV::Node_Linux;

PACKAGE deploymentview::DV
PUBLIC

WITH interfaceview::IV::HKFDIRMng;

WITH interfaceview::IV::TCManager;

WITH interfaceview::IV::Legacy;

WITH interfaceview::IV::BKGTCExec;


WITH ocarina_processors_x86;
WITH deploymentview::DV::Node_Linux;
WITH Taste;
WITH Deployment;
WITH interfaceview::IV;
WITH TASTE_DV_Properties;

SYSTEM Node_Linux
END Node_Linux;

SYSTEM IMPLEMENTATION Node_Linux.others
SUBCOMPONENTS
   IV_HKFDIRMng : SYSTEM interfaceview::IV::HKFDIRMng::HKFDIRMng.others {
      Taste::FunctionName => "HKFDIRMng";
   };

   IV_TCManager : SYSTEM interfaceview::IV::TCManager::TCManager.others {
      Taste::FunctionName => "TCManager";
   };

   IV_Legacy : SYSTEM interfaceview::IV::Legacy::Legacy.others {
      Taste::FunctionName => "Legacy";
   };

   IV_BKGTCExec : SYSTEM interfaceview::IV::BKGTCExec::BKGTCExec.others {
      Taste::FunctionName => "BKGTCExec";
   };

   demo : PROCESS deploymentview::DV::Node_Linux::demo.others {
      Deployment::Port_Number => 0;
      TASTE_DV_Properties::CoverageEnabled => false;
      TASTE::CFlags => "-no-pie";
      TASTE::LDFlags => "-no-pie";
   };
   x86_linux : PROCESSOR ocarina_processors_x86::x86.generic_linux;
PROPERTIES
   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_HKFDIRMng;
   
   
   
   
   
   
   

   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_TCManager;
   
   
   
   
   
   
   

   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_Legacy;
   
   
   
   
   
   
   

   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_BKGTCExec;
   
   
   
   
   
   
   

   Actual_Processor_Binding => (reference (x86_linux)) APPLIES TO demo;
END Node_Linux.others;

SYSTEM deploymentview
END deploymentview;

SYSTEM IMPLEMENTATION deploymentview.others
SUBCOMPONENTS
  Node_Linux : SYSTEM Node_Linux.others;
  interfaceview : SYSTEM interfaceview::IV::interfaceview.others;
END deploymentview.others;

PROPERTIES
  Taste::coordinates => "0 0 297000 210000";
  Taste::version => "3.0";
  Taste::interfaceView => "InterfaceView.aadl";
  Taste::HWLibraries => ("ocarina_components.aadl");
END deploymentview::DV;