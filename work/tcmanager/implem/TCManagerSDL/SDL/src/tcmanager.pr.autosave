/* CIF PROCESS (250, 150), (150, 75) */

process Tcmanager;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (38, 445), (266, 140) */
    -- Text area for declarations and comments
    dcl acceptance RxTC;
    dcl packet RawTC;
    dcl fwdComm FwdCommand;
    dcl tc Telecommand;
    dcl toReboot GToReboot;
    dcl toFDIR GFwToHK_FDIR;
    dcl toBKG GFwToBKG;
    /* CIF ENDTEXT */
    /* CIF procedure (48, 241), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure doInit;
        /* CIF START (182, 53), (70, 35) */
        START;
            /* CIF PROCEDURECALL (182, 108), (70, 35) */
            call Init;
            /* CIF return (199, 163), (35, 35) */
            return ;
    endprocedure;
    /* CIF procedure (105, 313), (95, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure doNewRxTC;
        /* CIF START (145, 40), (70, 35) */
        START;
            /* CIF PROCEDURECALL (94, 95), (171, 35) */
            call NewRxTC(tc, acceptance);
            /* CIF return (162, 150), (35, 35) */
            return ;
    endprocedure;
    /* CIF procedure (777, 24), (116, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure doNewEvAction;
        /* CIF START (233, 75), (70, 35) */
        START;
            /* CIF PROCEDURECALL (179, 130), (176, 35) */
            call NewEvAction(acceptance);
            /* CIF return (250, 185), (35, 35) */
            return ;
    endprocedure;
    /* CIF procedure (919, 31), (81, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure doReboot;
        /* CIF START (218, 67), (70, 35) */
        START;
            /* CIF PROCEDURECALL (218, 122), (70, 35) */
            call Reboot;
            /* CIF return (235, 177), (35, 35) */
            return ;
    endprocedure;
    /* CIF procedure (1076, 183), (95, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure doHandleTC;
        /* CIF START (289, 121), (70, 35) */
        START;
            /* CIF PROCEDURECALL (226, 176), (194, 35) */
            call HandleTC(fwdComm, packet);
            /* CIF return (306, 231), (35, 35) */
            return ;
    endprocedure;
    /* CIF START (63, 2), (70, 35) */
    START;
        /* CIF PROCEDURECALL (0, 76), (197, 35) */
        call writeln("[TCManager] starts");
        /* CIF PROCEDURECALL (63, 131), (70, 35) */
        call doInit;
        /* CIF NEXTSTATE (63, 181), (70, 35) */
        NEXTSTATE Ready;
    /* CIF state (1060, 8), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Reboot;
        /* CIF provided (1060, 63), (70, 35) */
        provided true;
            /* CIF PROCEDURECALL (1056, 118), (78, 35) */
            call doreboot;
    endstate;
    /* CIF state (876, 118), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state ValidTC;
        /* CIF provided (876, 173), (70, 35) */
        provided true;
            /* CIF PROCEDURECALL (866, 228), (91, 35) */
            call doHandletc;
            /* CIF decision (869, 278), (83, 50) */
            decision fwdComm
            /* CIF comment (975, 285), (79, 35) */
            comment 'HandleTC';
                /* CIF ANSWER (788, 348), (97, 23) */
                (exec_prio_tc):
                    /* CIF NEXTSTATE (802, 391), (70, 35) */
                    NEXTSTATE Ready;
                /* CIF ANSWER (661, 348), (82, 23) */
                (to_reboot):
                    /* CIF NEXTSTATE (667, 391), (70, 35) */
                    NEXTSTATE Reboot;
                /* CIF ANSWER (896, 348), (105, 23) */
                (fwdhk_fdir_tc):
                    /* CIF output (880, 391), (137, 35) */
                    output SHKFDIRTC(packet);
                /* CIF ANSWER (1014, 348), (78, 23) */
                (fwdbkgtc):
                    /* CIF output (995, 391), (117, 35) */
                    output SBKGTC(packet);
            enddecision;
            /* CIF NEXTSTATE (876, 445), (70, 35) */
            NEXTSTATE Ready;
    endstate;
    /* CIF state (392, 23), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Ready;
        /* CIF input (433, 78), (70, 35) */
        input poll;
            /* CIF PROCEDURECALL (401, 128), (135, 35) */
            call PollTC(acceptance);
            /* CIF decision (424, 178), (89, 50) */
            decision acceptance;
                /* CIF ANSWER (364, 248), (76, 23) */
                (accepted):
                    /* CIF NEXTSTATE (367, 286), (70, 35) */
                    NEXTSTATE ValidTC;
                /* CIF ANSWER (441, 248), (103, 23) */
                (not_accepted):
                    /* CIF NEXTSTATE (458, 286), (70, 35) */
                    NEXTSTATE Ready;
            enddecision;
        /* CIF input (571, 83), (81, 35) */
        input SevAction;
            /* CIF PROCEDURECALL (555, 138), (113, 35) */
            call donewevaction;
            /* CIF NEXTSTATE (577, 188), (70, 35) */
            NEXTSTATE ValidTC;
    endstate;
endprocess Tcmanager;