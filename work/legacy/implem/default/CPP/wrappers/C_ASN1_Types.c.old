#ifdef __unix__
#include <stdio.h>
#include <assert.h>
#endif

#include <string.h>

#include "C_ASN1_Types.h.old"

#ifdef __NEED_RawTC_UPER
int Encode_UPER_RawTC(void *pBuffer, size_t iMaxBufferSize, const asn1SccRawTC *pSrc, int *errorCode)
{
    (void)iMaxBufferSize;
    int outErrorCode;
    STATIC BitStream strm;

    BitStream_Init(&strm, pBuffer, iMaxBufferSize);
    if (asn1SccRawTC_Encode(pSrc, &strm, &outErrorCode, TRUE) == FALSE) {
       if (errorCode != NULL) {
           *errorCode = outErrorCode;
       }
#ifdef __unix__
	fprintf(stderr, "Could not encode RawTC (at %s, %d), errorCode was %d\n", __FILE__, __LINE__, outErrorCode);
#endif
        return -1;
    } else {
        return BitStream_GetLength(&strm);
    }
}
#endif

#ifdef __NEED_RawTC_ACN
int Encode_ACN_RawTC(void *pBuffer, size_t iMaxBufferSize, asn1SccRawTC *pSrc, int *errorCode)
{
    (void)iMaxBufferSize;
    int outErrorCode;
    STATIC BitStream strm;

    BitStream_Init(&strm, pBuffer, iMaxBufferSize);
    if (asn1SccRawTC_ACN_Encode(pSrc, &strm, &outErrorCode, TRUE) == FALSE) {
       if (errorCode != NULL) {
           *errorCode = outErrorCode;
       }
#ifdef __unix__
	fprintf(stderr, "Could not encode RawTC (at %s, %d), errorCode was %d\n", __FILE__, __LINE__, outErrorCode);
#endif
        return -1;
    } else {
        return BitStream_GetLength(&strm);
    }
}
#endif

#ifdef __NEED_RawTC_NATIVE
int Encode_NATIVE_RawTC(void *pBuffer, size_t iMaxBufferSize, const asn1SccRawTC *pSrc)
{
    (void)iMaxBufferSize;
    memcpy(pBuffer, pSrc, sizeof(asn1SccRawTC) );
    return sizeof(asn1SccRawTC);
}
#endif

#ifdef __NEED_RawTC_UPER
int Decode_UPER_RawTC(asn1SccRawTC *pDst, void *pBuffer, size_t iBufferSize, int *errorCode)
{
    (void)iBufferSize;
    int outErrorCode;

    STATIC BitStream strm;

    BitStream_AttachBuffer(&strm, pBuffer, iBufferSize);

    if (asn1SccRawTC_Decode(pDst, &strm, &outErrorCode)) {
        /* Decoding succeeded */
        return 0;
    } else {
       if (errorCode != NULL) {
           *errorCode = outErrorCode;
       }
#ifdef __unix__
	fprintf(stderr, "Could not decode RawTC (at %s, %d), error code was %d\n", __FILE__, __LINE__, outErrorCode);
#endif
        return -1;
    }
}
#endif

#ifdef __NEED_RawTC_ACN
int Decode_ACN_RawTC(asn1SccRawTC *pDst, void *pBuffer, size_t iBufferSize, int *errorCode)
{
    (void)iBufferSize;
    int outErrorCode;

    STATIC BitStream strm;

    BitStream_AttachBuffer(&strm, pBuffer, iBufferSize);

    if (asn1SccRawTC_ACN_Decode(pDst, &strm, &outErrorCode)) {
        /* Decoding succeeded */
        return 0;
    } else {
       if (errorCode != NULL) {
           *errorCode = outErrorCode;
       }
#ifdef __unix__
	fprintf(stderr, "Could not decode RawTC (at %s, %d), error code was %d\n", __FILE__, __LINE__, outErrorCode);
#endif
        return -1;
    }
}
#endif

#ifdef __NEED_RawTC_NATIVE
int Decode_NATIVE_RawTC(asn1SccRawTC *pDst, void *pBuffer, size_t iBufferSize)
{
    (void)iBufferSize;
    *pDst = *(asn1SccRawTC *) pBuffer;
    {
        return 0;
    }
}
#endif

